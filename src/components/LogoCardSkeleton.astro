---
/** Loading placeholder with the same footprint as a LogoCard. Styles live in LogoCard.astro. */
---

<div class="lc lc--skeleton" aria-hidden="true">
  <div class="lc__logo lc-skel"></div>
  <div class="lc__meta">
    <div class="lc-skel lc-skel--name"></div>
    <div class="lc-skel lc-skel--pill"></div>
  </div>
  <div class="lc__actions">
    <div class="lc-skel lc-skel--btn"></div>
    <div class="lc-skel lc-skel--btn"></div>
  </div>
</div>
