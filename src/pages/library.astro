---
// The library now lives on the home page. Keep old links (and ?category=) working.
const title = "Library - Nigerian Bank Logos";
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href="/#library" />
    <meta http-equiv="refresh" content="0; url=/#library" />
    <script is:inline>
      location.replace("/" + location.search + "#library");
    </script>
  </head>
  <body>
    <a href="/#library">The library has moved to the home page.</a>
  </body>
</html>
